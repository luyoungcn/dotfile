# 定义 WSL 代理开关函数
proxy () {
    # 动态获取最新的 Windows 宿主机 IP
    local host_ip=$(ip route | grep default | awk '{print $3}')

    if [ -z "$host_ip" ]; then
        # 兼容备用方案：从 /etc/resolv.conf 获取
        host_ip=$(grep "nameserver" /etc/resolv.conf | awk '{print $2}')
    fi

    if [ -z "$host_ip" ]; then
        echo "Error: Unable to detect Windows Host IP."
        return 1
    fi

    # 代理服务端口（请确认与 Windows 代理软件设置一致）
    local proxy_port="10811"
    local proxy_url="http://${host_ip}:${proxy_port}"

    # 同时导出大小写环境变量，确保覆盖所有命令行工具
    export http_proxy="$proxy_url"
    export https_proxy="$proxy_url"
    export all_proxy="$proxy_url"
    export HTTP_PROXY="$proxy_url"
    export HTTPS_PROXY="$proxy_url"
    export ALL_PROXY="$proxy_url"

    echo "Proxy enabled -> Windows Host: ${host_ip}:${proxy_port}"

    # 快速测试连通性（可选项）
    curl -I -s --connect-timeout 2 https://www.google.com | head -n 1
}

unproxy () {
    # 批量取消代理环境变量
    unset http_proxy https_proxy all_proxy
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
    echo "Proxy disabled."
}

# Docker SDK 快速启动与进入工具函数
denter() {
    local container_name="$1"
    local work_dir="${2:-/workspace}"
    local user="${3:-root}"
    local shell_bin="${4:-/bin/bash}"

    if [ -z "$container_name" ]; then
        echo "Error: Container name is required."
        return 1
    fi

    # 1. 检查容器是否存在
    if ! docker ps -a --format '{{.Names}}' | grep -q "^${container_name}$"; then
        echo "Error: Container '${container_name}' does not exist."
        return 1
    fi

    # 2. 如果容器未运行，则启动容器
    if [ "$(docker inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null)" != "true" ]; then
        echo "Starting container '${container_name}'..."
        docker start "$container_name" >/dev/null || return 1
    fi

    # 3. 进入容器
    echo "Entering '${container_name}' as '${user}' at '${work_dir}'..."
    docker exec -it -u "$user" -w "$work_dir" "$container_name" "$shell_bin"
}
# 为 denter 函数添加 Docker 容器名 Tab 自动补全
_denter_complete() {
    local -a containers
    containers=($(docker ps -a --format '{{.Names}}'))
    _describe 'containers' containers
}
compdef _denter_complete denter


